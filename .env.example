# Copia este archivo a ".env" y cambia los valores. El archivo .env NO debe subirse al repositorio.

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DB=disfraces_express

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-produccion

# Puertos publicados en tu maquina (cambialos si alguno esta ocupado).
MONGO_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=4200
